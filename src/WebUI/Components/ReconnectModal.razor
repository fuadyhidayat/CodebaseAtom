<script type="module" src="@Assets["Components/ReconnectModal.razor.js"]"></script>
<dialog id="components-reconnect-modal"
        class="mud-dialog reconnect-modal"
        data-nosnippet
        aria-live="assertive"
        aria-atomic="true">
    <div class="mud-dialog-content d-flex flex-column align-center gap-5">
        <div class="reconnect-icon-container d-flex align-center justify-center rounded-circle">
            <div class="reconnect-pulse-ring"></div>
            <div class="reconnect-pulse-ring delay-1"></div>
            <div class="reconnect-pulse-ring delay-2"></div>

            <svg class="mud-icon-root mud-svg-icon mud-icon-size-large mud-primary-text reconnect-icon"
                 focusable="false"
                 viewBox="0 0 24 24"
                 aria-hidden="true" role="img">
                <path d="M0 0h24v24H0z" fill="none"></path>
                <path d="M12 5c-3.87 0-7 3.13-7 7h2c0-2.76 2.24-5 5-5s5 2.24 5 5h2c0-3.87-3.13-7-7-7zm1 9.29c.88-.39 1.5-1.26 1.5-2.29 0-1.38-1.12-2.5-2.5-2.5S9.5 10.62 9.5 12c0 1.02.62 1.9 1.5 2.29v3.3L7.59 21 9 22.41l3-3 3 3L16.41 21 13 17.59v-3.3zM12 1C5.93 1 1 5.93 1 12h2c0-4.97 4.03-9 9-9s9 4.03 9 9h2c0-6.07-4.93-11-11-11z" fill="currentColor" />
            </svg>
            <svg class="mud-icon-root mud-svg-icon mud-icon-size-large mud-error-text reconnect-icon-error"
                 viewBox="0 0 24 24"
                 focusable="false"
                 aria-hidden="true">
                <path d="M0,0h24v24H0V0z" fill="none" />
                <path d="M2.81,2.81L1.39,4.22l2.69,2.69C2.78,8.6,2,10.71,2,13c0,2.76,1.12,5.26,2.93,7.07l1.42-1.42C4.9,17.21,4,15.21,4,13 c0-1.75,0.57-3.35,1.51-4.66l1.43,1.43C6.35,10.7,6,11.81,6,13c0,1.66,0.68,3.15,1.76,4.24l1.42-1.42C8.45,15.1,8,14.11,8,13 c0-0.63,0.15-1.23,0.41-1.76l1.61,1.61c0,0.05-0.02,0.1-0.02,0.15c0,0.55,0.23,1.05,0.59,1.41C10.95,14.77,11.45,15,12,15 c0.05,0,0.1-0.01,0.16-0.02l7.62,7.62l1.41-1.41L2.81,2.81z M17.7,14.87C17.89,14.28,18,13.65,18,13c0-3.31-2.69-6-6-6 c-0.65,0-1.28,0.1-1.87,0.3l1.71,1.71C11.89,9,11.95,9,12,9c2.21,0,4,1.79,4,4c0,0.05,0,0.11-0.01,0.16L17.7,14.87z M12,5 c4.42,0,8,3.58,8,8c0,1.22-0.27,2.37-0.77,3.4l1.49,1.49C21.53,16.45,22,14.78,22,13c0-5.52-4.48-10-10-10 c-1.78,0-3.44,0.46-4.89,1.28l1.48,1.48C9.63,5.27,10.78,5,12,5z" fill="currentColor" />
            </svg>
            <svg class="mud-icon-root mud-svg-icon mud-icon-size-large reconnect-icon-pause"
                 viewBox="0 0 24 24"
                 focusable="false"
                 aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" fill="currentColor" />
            </svg>
        </div>

        <div class="text-center">
            <h2 class="mud-typography mud-typography-h2 mb-2 components-reconnect-first-attempt-visible">
                Reconnecting...
            </h2>
            <p class="mud-typography mud-typography-body1 reconnect-subtitle components-reconnect-first-attempt-visible">
                Restoring connection to the server
            </p>

            <h2 class="mud-typography mud-typography-h2 mb-2 components-reconnect-repeated-attempt-visible">
                Retrying connection
            </h2>
            <p class="mud-typography mud-typography-body1 reconnect-subtitle components-reconnect-repeated-attempt-visible">
                Next attempt in <span id="components-seconds-to-next-attempt" class="mud-chip mud-chip-filled mud-chip-color-primary mud-chip-size-small"></span> seconds
            </p>

            <h2 class="mud-typography mud-typography-h2 mud-error-text mb-2 components-reconnect-failed-visible">
                Connection lost
            </h2>
            <p class="mud-typography mud-typography-body1 reconnect-subtitle components-reconnect-failed-visible">
                Could not restore connection to the server
            </p>

            <h2 class="mud-typography mud-typography-h2 reconnect-pause-title mb-2 components-pause-visible">
                Session paused
            </h2>
            <p class="mud-typography mud-typography-body1 reconnect-subtitle components-pause-visible">
                The server has temporarily paused the session
            </p>

            <h2 class="mud-typography mud-typography-h2 mud-error-text mb-2 components-resume-failed-visible">
                Resume failed
            </h2>
            <p class="mud-typography mud-typography-body1 reconnect-subtitle components-resume-failed-visible">
                Could not resume the session. Please reload the page.
            </p>
        </div>
    </div>
    <div class="d-flex justify-center reconnect-actions">
        <button id="components-reconnect-button"
                type="button"
                class="reconnect-primary-button mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-medium mud-ripple mud-button-disable-elevation components-reconnect-failed-visible">
            <span class="mud-button-label">
                <span class="mud-button-icon-start mud-button-icon-size-medium">
                    <svg class="mud-icon-root mud-svg-icon mud-icon-size-medium"
                         viewBox="0 0 24 24"
                         focusable="false"
                         aria-hidden="true">
                        <path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                    </svg>
                </span>
                Retry
            </span>
        </button>
        <button id="components-resume-button"
                type="button"
                class="reconnect-primary-button mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-medium mud-ripple mud-button-disable-elevation components-pause-visible">
            <span class="mud-button-label">
                <span class="mud-button-icon-start mud-button-icon-size-medium">
                    <svg class="mud-icon-root mud-svg-icon mud-icon-size-medium"
                         viewBox="0 0 24 24"
                         focusable="false"
                         aria-hidden="true">
                        <path d="M8 5v14l11-7z" />
                    </svg>
                </span>
                Resume
            </span>
        </button>
    </div>
</dialog>
