@if (string.IsNullOrWhiteSpace(Title))
{
    <PageTitle>@ApplicationOptionsProvider.Value.ApplicationName</PageTitle>
}
else
{
    <PageTitle>@Title | @ApplicationOptionsProvider.Value.ApplicationName</PageTitle>
}


@code {
    [Inject]
    public required IOptions<ApplicationOptions> ApplicationOptionsProvider { get; init; }

    [Parameter, EditorRequired]
    public string Title { get; init; }
}
