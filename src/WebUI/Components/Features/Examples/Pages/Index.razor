@page "/Examples"
@inherits PageBase

<HtmlHead Title="@ExamplesDisplayTextFor.Examples" />
<Breadcrumbs Items="BreadcrumbItems" />
<MudText Typo="Typo.h1">
    <span class="blue-text">
        @ExamplesDisplayTextFor.Explore
    </span>
    <span class="red-text">
        @ExamplesDisplayTextFor.Examples
    </span>
</MudText>
<MudStack>
    <MudText Typo="Typo.h2" Class="mt-10 mb-2">
        @ExamplesDisplayTextFor.Theme
    </MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.Elevations">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.Red.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 red-text">
                        @ExamplesDisplayTextFor.Elevations
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        The usage of @ExamplesDisplayTextFor.Elevations
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.Palette">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.Pink.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 pink-text">
                        @ExamplesDisplayTextFor.Palette
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        The usage of @ExamplesDisplayTextFor.Palette
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.Typography">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.Indigo.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 indigo-text">
                        @ExamplesDisplayTextFor.Typography
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        The usage of @ExamplesDisplayTextFor.Typography
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
    </MudGrid>
    <MudText Typo="Typo.h2" Class="mt-10 mb-2">
        @ExamplesDisplayTextFor.Usage
    </MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.Buttons">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.Purple.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 purple-text">
                        @ExamplesDisplayTextFor.Buttons
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        The usage of @ExamplesDisplayTextFor.Buttons
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.ButtonPanels">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.DeepPurple.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 deep-purple-text">
                        @ExamplesDisplayTextFor.ButtonPanels
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        The usage of @ExamplesDisplayTextFor.ButtonPanels
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.Defaults">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.Blue.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 blue-text">
                        @ExamplesDisplayTextFor.Defaults
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        Components with default property values
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.TextFields">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.LightBlue.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 light-blue-text">
                        @ExamplesDisplayTextFor.TextFields
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        Various examples of @ExamplesDisplayTextFor.TextFields
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.Icons">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.Cyan.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 cyan-text">
                        @ExamplesDisplayTextFor.Icons
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        The usage of @ExamplesDisplayTextFor.Icons
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.ErrorHandling">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.LightGreen.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 light-green-text">
                        @ExamplesDisplayTextFor.ErrorHandling
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        How to handle errors
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
    </MudGrid>
    <MudText Typo="Typo.h2" Class="mt-10 mb-2">
        @ExamplesDisplayTextFor.Loadings
    </MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.LoadingLinear">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.Orange.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 orange-text">
                        @ExamplesDisplayTextFor.LoadingLinear
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        The usage of <code>LoadingLinear</code> component
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <a href="@ExamplesRouteFor.LoadingOverlay">
                <Paper25 Class="pa-5 hover-shadow" Style="@($"border-right-color: {Colors.DeepOrange.Default};")">
                    <MudText Typo="Typo.h3" Class="mb-10 deep-orange-text">
                        @ExamplesDisplayTextFor.LoadingOverlay
                    </MudText>
                    <MudText Typo="Typo.subtitle1">
                        The usage of <code>LoadingOverlay</code> component
                    </MudText>
                </Paper25>
            </a>
        </MudItem>
    </MudGrid>
</MudStack>
