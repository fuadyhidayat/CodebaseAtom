                <div class="d-flex">
                    <MudPaper Elevation="0"
                              Class="flex-grow-1 rounded-0 rounded-bl white-text"
                              Style="background-color: var(--mud-palette-secondary-lighten);">
                        <MudText Align="Align.Center" Class="py-6">
                            Lighten
                            <div>@MudColor.Parse(ThemeFor.Default.PaletteLight.SecondaryLighten).ToString(MudColorOutputFormats.Hex).ToUpper()</div>
