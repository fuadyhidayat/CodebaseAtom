@page "/Examples/Palette"
@inherits PageBase
@using MudBlazor.Utilities
@using Vioren.CodebaseAtom.WebUI.Components.Statics

<HtmlHead Title="@ExamplesDisplayTextFor.Palette" />
<Breadcrumbs Items="BreadcrumbItems" />
<PageHeader Title="@ExamplesDisplayTextFor.Palette" />
<MudText>
    The palette is the colors the theme uses for all the components and main layout.
</MudText>
<PageSection SectionTitle="Built-In Colors" Class="mt-5">
    <MudGrid>
        <MudItem xs="12" sm="12" md="4">
            <MudPaper Class="mud-theme-primary">
                <MudText Align="Align.Center" Class="py-6">
                    Primary
                    <div>@ThemeFor.Default.PaletteLight.Primary.ToString(MudColorOutputFormats.Hex).ToUpper()</div>
                    <div>@ThemeFor.Default.PaletteLight.Primary.ToString(MudColorOutputFormats.RGB).ToUpper()</div>
                </MudText>
                <div class="d-flex">
                    <MudPaper Elevation="0"
                              Class="flex-grow-1 rounded-0 rounded-bl white-text"
                              Style="background-color: var(--mud-palette-primary-lighten);">
                        <MudText Align="Align.Center" Class="py-6">
                            Lighten
                            <div>@MudColor.Parse(ThemeFor.Default.PaletteLight.PrimaryLighten).ToString(MudColorOutputFormats.Hex).ToUpper()</div>
                            <div>@MudColor.Parse(ThemeFor.Default.PaletteLight.PrimaryLighten).ToString(MudColorOutputFormats.RGB).ToUpper()</div>
                        </MudText>
                    </MudPaper>
                    <MudPaper Elevation="0"
                              Class="flex-grow-1 rounded-0 rounded-br white-text"
                              Style="background-color: var(--mud-palette-primary-darken);">
                        <MudText Align="Align.Center" Class="py-6">
                            Darken
                            <div>@MudColor.Parse(ThemeFor.Default.PaletteLight.PrimaryDarken).ToString(MudColorOutputFormats.Hex).ToUpper()</div>
                            <div>@MudColor.Parse(ThemeFor.Default.PaletteLight.PrimaryDarken).ToString(MudColorOutputFormats.RGB).ToUpper()</div>
                        </MudText>
                    </MudPaper>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="12" md="4">
            <MudPaper Class="mud-theme-secondary">
                <MudText Align="Align.Center" Class="py-6">
                    Secondary
