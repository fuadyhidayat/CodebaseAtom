                        <div>@ThemeFor.Default.PaletteLight.TextSecondary.ToString(MudColorOutputFormats.RGBA).ToUpper()</div>
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="12" md="4">
