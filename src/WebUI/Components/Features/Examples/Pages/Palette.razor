                        <div>@ThemeFor.Default.PaletteLight.TextDisabled.ToString(MudColorOutputFormats.HexA).ToUpper()</div>
                        <div>@ThemeFor.Default.PaletteLight.TextDisabled.ToString(MudColorOutputFormats.RGBA).ToUpper()</div>
