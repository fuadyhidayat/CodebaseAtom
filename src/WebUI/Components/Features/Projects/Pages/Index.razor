@page "/Projects"
@inherits PageBase

<HtmlHead Title="@DomainDisplayTextFor.Projects" />
<Breadcrumbs Items="BreadcrumbItems" />
<PageHeader Title="@DomainDisplayTextFor.Projects" />
<ErrorViewer Exception="ExceptionBase" />
<LoadingLinear IsVisible="IsLoadingBase" />

@if (_projects is not null)
{
    <MudStack Spacing="4">
        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center">
            @if (_projects.Any())
            {
                <TextFieldSearch @bind-Value="_searchKeyword" />
            }
            <MudSpacer />
            <AuthorizeView Roles="@RoleNameFor.Administrator">
                <Authorized>
                    <ButtonAdd EntityType="@DomainDisplayTextFor.Project" OnClick="ShowDialogAddProject" />
                </Authorized>
            </AuthorizeView>
        </MudStack>
        @if (_projects.Any())
        {
            <TableDefault Items="_projects"
                          Loading="IsLoadingBase"
                          Filter="FilterProjects">
                <HeaderContent>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<ProjectModel, object>(x => x.Title)" InitialDirection="SortDirection.Ascending">
                            @DomainDisplayTextFor.Title
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<ProjectModel, object>(x => x.Description)">
                            @DomainDisplayTextFor.Description
                        </MudTableSortLabel>
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@DomainDisplayTextFor.Title">
                        <MudLink Href="@ProjectsRouteFor.ProjectDetails(context.Id)">
                            <MudHighlighter Text="@context.Title" HighlightedText="@_searchKeyword" />
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="@DomainDisplayTextFor.Description">
                        <MudHighlighter Text="@context.Description" HighlightedText="@_searchKeyword" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Variant="Variant.Filled"
                              Severity="Severity.Warning"
                              Class="ma-5">
                        There are no @DomainDisplayTextFor.Projects matching the selected filters. Please adjust your search criteria and try again.
                    </MudAlert>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </TableDefault>
        }
        else
        {
            <MudAlert>
                There are no @DomainDisplayTextFor.Projects yet.
            </MudAlert>
        }
    </MudStack>
}
