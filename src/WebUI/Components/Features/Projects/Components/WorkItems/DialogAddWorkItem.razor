@inherits DialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Class="mb-3">
            <LoadingLinear IsVisible="IsLoadingBase" />
            <ErrorViewer Exception="ExceptionBase" />
            <MudForm @ref="_form" Model="@_model" Validation="@_validator.ValidateValue">
                <GridDefault>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.Title"
                                          Placeholder="@($"Enter the {DomainDisplayTextFor.WorkItem} {DomainDisplayTextFor.Title}")"
                                          @bind-Value="_model.Title"
                                          For="@(() => _model.Title)" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldMultiline Label="@DomainDisplayTextFor.Description"
                                            Placeholder="@($"Enter the {DomainDisplayTextFor.WorkItem} {DomainDisplayTextFor.Description}")"
                                            Lines="3"
                                            MaxLines="5"
                                            @bind-Value="_model.Description"
                                            For="@(() => _model.Description)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <DatePickerDefault Label="@DomainDisplayTextFor.Deadline"
                                           @bind-Date="_model.DeadlineDateTime" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <SelectDefault Label="@DomainDisplayTextFor.Status"
                                       T="WorkItemStatus"
                                       Disabled="true">
                            <MudSelectItem Value="WorkItemStatus.NotStarted">
                                @WorkItemStatus.NotStarted.Name
                            </MudSelectItem>
                        </SelectDefault>
                    </MudItem>
                </GridDefault>
            </MudForm>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <ButtonCancel OnClick="HandleCancel" />
        <ButtonSubmit OnClick="HandleSubmit" />
    </DialogActions>
</MudDialog>
