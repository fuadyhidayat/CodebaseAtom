@inherits DialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Class="mb-3">
            <LoadingLinear IsVisible="IsLoadingBase" />
            <ErrorViewer Exception="ExceptionBase" />
            <MudForm @ref="_form" Model="@_model" Validation="@_validator.ValidateValue">
                <GridDefault>
                    <MudItem xs="12">
                        <FileUploadSingle Accept=".docx,.xlsx,.pptx,.pdf" OnFileUpdated="OnFileUpdated" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.Title"
                                          Placeholder="@($"Enter the {DomainDisplayTextFor.Document} {DomainDisplayTextFor.Title}")"
                                          AutoFocus="true"
                                          @bind-Value="_model.Title"
                                          For="@(() => _model.Title)" />
                    </MudItem>
                </GridDefault>
                <BottomButtonPanel>
                    <ButtonSubmit OnClick="HandleSubmit" Disabled="@(_model.File is null)" />
                </BottomButtonPanel>
            </MudForm>
        </MudStack>
    </DialogContent>
</MudDialog>
