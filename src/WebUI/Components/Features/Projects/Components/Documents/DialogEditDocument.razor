@inherits DialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Class="mb-3">
            <LoadingLinear IsVisible="IsLoadingBase" />
            <ErrorViewer Exception="ExceptionBase" />
            <MudForm @ref="_form" Model="@Model" Validation="@_validator.ValidateValue">
                <GridDefault>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.Title"
                                          Placeholder="@($"Enter the {DomainDisplayTextFor.Document} {DomainDisplayTextFor.Title}")"
                                          @bind-Value="Model.Title"
                                          For="@(() => Model.Title)" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.FileName"
                                          Placeholder="@($"Enter the {DomainDisplayTextFor.Document} {DomainDisplayTextFor.FileName}")"
                                          AutoFocus="true"
                                          @bind-Value="Model.FileNameWithoutExtension"
                                          AdornmentText="@Model.FileExtension"
                                          Adornment="Adornment.End"
                                          For="@(() => Model.FileNameWithoutExtension)" />
                    </MudItem>
                </GridDefault>
                <BottomButtonPanel>
                    <ButtonSave OnClick="HandleSubmit" />
                </BottomButtonPanel>
            </MudForm>
        </MudStack>
    </DialogContent>
</MudDialog>
