@inherits DialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Class="mb-3">
            <LoadingLinear IsVisible="IsLoadingBase" />
            <ErrorViewer Exception="ExceptionBase" />
            <MudForm @ref="_form" Model="@_model" Validation="@_validator.ValidateValue">
                <GridDefault>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.Title"
                                          Placeholder="@($"Enter the {DomainDisplayTextFor.Project} {DomainDisplayTextFor.Title}")"
                                          @bind-Value="_model.Title"
                                          For="@(() => _model.Title)" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldMultiline Label="@DomainDisplayTextFor.Description"
                                            Placeholder="@($"Enter the {DomainDisplayTextFor.Project} {DomainDisplayTextFor.Description}")"
                                            Lines="3"
                                            MaxLines="5"
                                            @bind-Value="_model.Description"
                                            For="@(() => _model.Description)" />
                    </MudItem>
                </GridDefault>
            </MudForm>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <ButtonCancel OnClick="HandleCancel" />
        <ButtonSubmit OnClick="HandleSubmit" />
    </DialogActions>
</MudDialog>
