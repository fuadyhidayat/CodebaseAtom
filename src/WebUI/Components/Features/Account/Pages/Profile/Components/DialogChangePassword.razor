@inherits DialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Class="mb-3">
            <ErrorViewer Exception="ExceptionBase" />
            @if (Model is not null)
            {
                <EditForm Model="Model" OnValidSubmit="OnValidSubmitAsync">
                    <DataAnnotationsValidator />
                    <GridDefault>
                        <MudItem xs="12">
                            <TextFieldDefault Label="Current Password"
                                              Placeholder="Enter the current password"
                                              InputType="InputType.Password"
                                              @bind-Value="Model.CurrentPassword"
                                              For="@(() => Model.CurrentPassword)" />
                        </MudItem>
                        <MudItem xs="12">
                            <TextFieldDefault Label="New Password"
                                              Placeholder="Enter the new password"
                                              InputType="InputType.Password"
                                              @bind-Value="Model.NewPassword"
                                              For="@(() => Model.NewPassword)" />
                        </MudItem>
                        <MudItem xs="12">
                            <TextFieldDefault Label="Confirm Password"
                                              Placeholder="Re-enter the new password"
                                              InputType="InputType.Password"
                                              @bind-Value="Model.ConfirmPassword"
                                              For="@(() => Model.ConfirmPassword)" />
                        </MudItem>
                        <MudItem xs="12">
                            <ButtonSave ButtonType="ButtonType.Submit" />
                        </MudItem>
                    </GridDefault>
                </EditForm>
            }
        </MudStack>

        <MudMessageBox @ref="_messageBoxChangePassword" Title="@($"{DomainDisplayTextFor.Password} {UIDisplayTextFor.Reset}")">
            <MessageContent>
                <MudAlert Severity="Severity.Success">
                    Your @DomainDisplayTextFor.Password has been changed.
                    You will have to log in again with the new password.
                </MudAlert>
            </MessageContent>
        </MudMessageBox>
    </DialogContent>
</MudDialog>
