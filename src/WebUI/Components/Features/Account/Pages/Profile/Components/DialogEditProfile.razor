@inherits DialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Class="mb-3">
            <ErrorViewer Exception="ExceptionBase" />
            @if (Model is not null)
            {
                <EditForm Model="Model" OnValidSubmit="OnValidSubmitAsync">
                    <DataAnnotationsValidator />
                    <GridDefault>
                        <MudItem xs="12">
                            <TextFieldDefault Label="@DomainDisplayTextFor.DisplayName"
                                              Placeholder="@($"Enter your {DomainDisplayTextFor.DisplayName}")"
                                              @bind-Value="Model.DisplayName"
                                              For="@(() => Model.DisplayName)" />
                        </MudItem>
                        <MudItem xs="12">
                            <TextFieldDefault Label="@DomainDisplayTextFor.Email"
                                              Placeholder="@($"Enter your {DomainDisplayTextFor.Email}")"
                                              @bind-Value="Model.NewEmail"
                                              For="@(() => Model.NewEmail)" />
                        </MudItem>
                    </GridDefault>
                    <BottomButtonPanel>
                        <ButtonCancel OnClick="Cancel" Disabled="@IsLoadingBase" />
                        <ButtonConfirm ButtonType="ButtonType.Submit" />
                    </BottomButtonPanel>
                </EditForm>
            }
        </MudStack>
    </DialogContent>
</MudDialog>
