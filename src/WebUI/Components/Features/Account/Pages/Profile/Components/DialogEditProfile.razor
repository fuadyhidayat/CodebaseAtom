@inherits DialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Class="mb-3">
            <LoadingLinear IsVisible="IsLoadingBase" />
            <ErrorViewer Exception="ExceptionBase" />
            <MudForm @ref="_form" Model="@Model" Validation="@_validator.ValidateValue">
                <GridDefault>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.DisplayName"
                                          Placeholder="@($"Enter your {DomainDisplayTextFor.DisplayName}")"
                                          @bind-Value="Model.DisplayName"
                                          For="@(() => Model.DisplayName)" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.Email"
                                          Placeholder="@($"Enter your {DomainDisplayTextFor.Email}")"
                                          @bind-Value="Model.NewEmail"
                                          For="@(() => Model.NewEmail)" />
                    </MudItem>
                </GridDefault>
            </MudForm>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <ButtonCancel OnClick="HandleCancel" />
        <ButtonSubmit OnClick="HandleSubmit" />
    </DialogActions>
</MudDialog>
