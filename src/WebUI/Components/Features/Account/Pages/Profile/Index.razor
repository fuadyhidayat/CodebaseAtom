@page "/Account/Profile"

@inherits PageBase

<HtmlHead Title="Profile" />
<Breadcrumbs Items="BreadcrumbItems" />
<PageHeader Title="Profile" />
@if (_user is not null)
{
    <TopButtonPanel>
        <ButtonEdit OnClick="ShowDialogEditProfile">
            Edit Profile
        </ButtonEdit>
        <ButtonEdit OnClick="ShowDialogChangePassword">
            Change Password
        </ButtonEdit>
    </TopButtonPanel>
    <PageSection>
        <GridDefault>
            <MudItem xs="12" sm="6">
                <FieldDefault Label="@DomainDisplayTextFor.Username">
                    @_user.Username
                </FieldDefault>
            </MudItem>
            <MudItem xs="12" sm="6">
                <FieldDefault Label="@DomainDisplayTextFor.Email">
                    @_user.Email
                </FieldDefault>
            </MudItem>
            <MudItem xs="12" sm="6">
                <FieldDefault Label="@DomainDisplayTextFor.DisplayName">
                    @_user.DisplayName
                </FieldDefault>
            </MudItem>
            <MudItem xs="12" sm="6">
                <FieldDefault Label="@DomainDisplayTextFor.Roles">
                    @(_user.Roles.Any() ? string.Join(", ", _user.Roles) : "No Roles")
                </FieldDefault>
            </MudItem>
        </GridDefault>
    </PageSection>
}
