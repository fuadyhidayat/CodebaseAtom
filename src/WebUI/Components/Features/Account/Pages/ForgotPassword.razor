@page "/Account/ForgotPassword"

@layout LayoutLogin
@attribute [AllowAnonymous]

<MudDialogProvider />
<HtmlHead Title="Forgot your password?" />
<MudContainer MaxWidth="MaxWidth.Small">
    <PageHeader Title="Forgot your password?" />
    <LoadingLinear IsVisible="@_isLoading" />
    <ErrorViewer Exception="@_exception" />
    <PageSection>
        <MudForm @ref="_form" Model="@_model" Validation="@_validator.ValidateValue">
            <GridDefault>
                <MudItem xs="12">
                    <TextFieldDefault Label="@DomainDisplayTextFor.Email"
                                      Placeholder="name@example.com"
                                      @bind-Value="_model.Email"
                                      For="@(() => _model.Email)" />
                </MudItem>
            </GridDefault>
        </MudForm>
        <BottomButtonPanel>
            <ButtonPrimary StartIcon="@Icons.Material.Filled.LockReset" OnClick="HandleSubmit">
                @UIDisplayTextFor.Reset @DomainDisplayTextFor.Password
            </ButtonPrimary>
        </BottomButtonPanel>
        <MudDivider Class="my-2" />
        <MudStack AlignItems="AlignItems.Start">
            <MudLink Href="@AccountRouteFor.Login()">@UIDisplayTextFor.Login</MudLink>
        </MudStack>
    </PageSection>
    <MudMessageBox @ref="_messageBoxForgotPassword">
        <MessageContent>
            <MudLink Href="@_resetPasswordLink">
                <b>Click here</b>
            </MudLink>
            to reset your password.
        </MessageContent>
        <YesButton></YesButton>
    </MudMessageBox>
</MudContainer>
