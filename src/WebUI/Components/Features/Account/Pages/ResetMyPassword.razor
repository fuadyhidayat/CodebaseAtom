@page "/Account/ResetPassword"

@layout LayoutLogin
@attribute [AllowAnonymous]

<HtmlHead Title="Reset password" />
<MudContainer MaxWidth="MaxWidth.Small">
    <PageHeader Title="Reset your password" />
    <LoadingLinear IsVisible="_isLoading" />
    <ErrorViewer Exception="_exceptionCode" />
    @if (_succeeded)
    {
        <MudAlert Severity="Severity.Success">
            Your password has been reset. Please <MudLink Href="@AccountRouteFor.Login()"><b>click here to log in</b></MudLink>.
        </MudAlert>
    }
    else if (_exceptionCode is null)
    {
        <PageSection>
            <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync">
                <DataAnnotationsValidator />
                <input type="hidden" @bind="Input.Code" />
                <GridDefault>
                    <MudItem xs="12">
                        <TextFieldDefault Label="Username"
                                          Placeholder="Enter your username"
                                          @bind-Value="Input.Username"
                                          For="@(() => Input.Username)" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldDefault Label="Password"
                                          Placeholder="Enter your new password"
                                          InputType="InputType.Password"
                                          @bind-Value="Input.Password"
                                          For="@(() => Input.Password)" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldDefault Label="Confirm Password"
                                          Placeholder="Re-enter your new password"
                                          InputType="InputType.Password"
                                          @bind-Value="Input.ConfirmPassword"
                                          For="@(() => Input.ConfirmPassword)" />
                    </MudItem>
                    <MudItem xs="12">
                        <ButtonSubmit ButtonType="ButtonType.Submit" />
                    </MudItem>
                </GridDefault>
            </EditForm>
            <ErrorViewer Exception="_exception" />
            <MudDivider Class="my-2" />
            <MudStack AlignItems="AlignItems.Start">
                <MudLink Href="@AccountRouteFor.Login()">Login</MudLink>
            </MudStack>
        </PageSection>
    }
</MudContainer>
