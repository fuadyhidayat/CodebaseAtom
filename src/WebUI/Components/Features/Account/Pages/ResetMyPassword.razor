@page "/Account/ResetPassword"

@layout LayoutLogin
@attribute [AllowAnonymous]

<MudDialogProvider />
<HtmlHead Title="@($"{DomainDisplayTextFor.Password} {UIDisplayTextFor.Reset}")" />
<MudContainer MaxWidth="MaxWidth.Small">
    <PageHeader Title="@($"{UIDisplayTextFor.Reset} your {DomainDisplayTextFor.Password}")" />
    <LoadingLinear IsVisible="_isLoading" />
    <ErrorViewer Exception="_exception" />
    @if (_model is not null)
    {
        <PageSection>
            <MudForm @ref="_form" Model="@_model" Validation="@_validator.ValidateValue">
                <input type="hidden" @bind="_model.Token" />
                <GridDefault>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.Username"
                                          Placeholder="@($"Enter your {DomainDisplayTextFor.Username}")"
                                          @bind-Value="_model.Username"
                                          For="@(() => _model.Username)" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.Password"
                                          Placeholder="@($"Enter your new {DomainDisplayTextFor.Password}")"
                                          InputType="InputType.Password"
                                          @bind-Value="_model.Password"
                                          For="@(() => _model.Password)" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@DomainDisplayTextFor.ConfirmPassword"
                                          Placeholder="@($"Re-enter your new {DomainDisplayTextFor.Password}")"
                                          InputType="InputType.Password"
                                          @bind-Value="_model.ConfirmPassword"
                                          For="@(() => _model.ConfirmPassword)" />
                    </MudItem>
                    <MudItem xs="12">
                        <ButtonSubmit OnClick="HandleSubmit" />
                    </MudItem>
                </GridDefault>
            </MudForm>
            <MudDivider Class="my-2" />
            <MudStack AlignItems="AlignItems.Start">
                <MudLink Href="@AccountRouteFor.Login()">Login</MudLink>
            </MudStack>
        </PageSection>
    }

    <MudMessageBox @ref="_messageBoxPasswordReset" Title="@($"{DomainDisplayTextFor.Password} {UIDisplayTextFor.Reset}")">
        <MessageContent>
            <MudAlert Severity="Severity.Success">
                Your @DomainDisplayTextFor.Password has been reset.
                You will be redirected to the login page.
            </MudAlert>
        </MessageContent>
    </MudMessageBox>
</MudContainer>
