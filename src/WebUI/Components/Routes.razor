@using Vioren.CodebaseAtom.WebUI.Components.Features.Home.Pages

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(NotFound)">
    <Found Context="routeData">        
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(LayoutMain)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == false)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <StackAccessDenied />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>
