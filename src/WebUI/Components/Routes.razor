@using Vioren.CodebaseAtom.WebUI.Components.Features.Home.Pages
@using Vioren.CodebaseAtom.WebUI.Infrastructure.CurrentUser
@inject CurrentUserState CurrentUserState

<CurrentUserProvider>
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(LayoutMain)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == false)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <StackAccessDenied />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
    </Router>
</CurrentUserProvider>
