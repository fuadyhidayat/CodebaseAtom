root = false

# Override rules that are not meaningful in a Blazor Server application project.
[*.cs]

# CA1031: Blazor UI pages intentionally catch all exceptions to display errors to the user.
dotnet_diagnostic.CA1031.severity = none

# CA1034: C# 14 extension member blocks (extension(...) { }) are misidentified as nested public types by the analyzer.
# This is a false positive from the new language syntax; suppress until the analyzer is updated.
dotnet_diagnostic.CA1034.severity = none

# CA1515: Blazor components and DI-registered services follow their own accessibility conventions in application code.
dotnet_diagnostic.CA1515.severity = none

# CA1501: Excessive inheritance is not a concern in Blazor UI pages and DI-registered services.
dotnet_diagnostic.CA1501.severity = none
