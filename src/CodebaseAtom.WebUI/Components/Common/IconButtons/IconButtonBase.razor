@inherits ComponentBase

<MudTooltip Text="@TooltipText">
    <MudIconButton Icon="@Icon"
                   Color="@Color"
                   Size="@Size"
                   Href="@Href"
                   OnClick="@OnClick"
                   Disabled="@Disabled"
                   Class="@Class" />
</MudTooltip>

@code {
    [Parameter]
    public virtual string TooltipText { get; set; } = string.Empty;

    [Parameter]
    public virtual string Icon { get; set; } = string.Empty;

    [Parameter]
    public virtual Color Color { get; set; } = Color.Default;

    [Parameter]
    public Size Size { get; set; } = Size.Small;

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
