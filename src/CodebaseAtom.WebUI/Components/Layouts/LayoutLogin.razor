@using CodebaseAtom.WebUI.Components.Layouts.Components
@using CodebaseAtom.WebUI.Components.Statics

@inherits LayoutComponentBase

<MudThemeProvider Theme="@ThemeFor.NoAppBar" />
<MudLayout>
    <MudMainContent Class="main-content">
        <div class="content-wrapper">
            <MudStack Row="true"
                      Spacing="1"
                      Justify="Justify.Center"
                      AlignItems="AlignItems.Center"
                      Class="my-5">
                <div style="height: 60px;">
                    <MudLink Href="@HomeRouteFor.Index">
                        <MudImage Src="@Assets["img/logo.png"]" Alt="Logo" Class="menu-logo" />
                    </MudLink>
                </div>
                <MudText Style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.1rem;">
                    @ApplicationOptionsProvider.Value.ApplicationName
                </MudText>
            </MudStack>
            <MudDivider DividerType="DividerType.Middle" />
            <div class="page-content">
                @Body
            </div>
            <Footer />
        </div>
    </MudMainContent>
</MudLayout>
