@inherits DialogBase

<MudDialog>
    <DialogContent>
        <MudStack Class="mb-5">
            <ErrorViewer Exception="ExceptionBase" />

            @if (_input is not null)
            {
                <EditForm Model="_input" OnValidSubmit="OnValidSubmitAsync">
                    <DataAnnotationsValidator />
                    <GridDefault>
                        <MudItem xs="12">
                            <TextFieldDefault Label="Current Password"
                                              Placeholder="Enter the current password"
                                              InputType="InputType.Password"
                                              @bind-Value="_input.CurrentPassword"
                                              For="@(() => _input.CurrentPassword)" />
                        </MudItem>
                        <MudItem xs="12">
                            <TextFieldDefault Label="New Password"
                                              Placeholder="Enter the new password"
                                              InputType="InputType.Password"
                                              @bind-Value="_input.NewPassword"
                                              For="@(() => _input.NewPassword)" />
                        </MudItem>
                        <MudItem xs="12">
                            <TextFieldDefault Label="Confirm Password"
                                              Placeholder="Re-enter the new password"
                                              InputType="InputType.Password"
                                              @bind-Value="_input.ConfirmPassword"
                                              For="@(() => _input.ConfirmPassword)" />
                        </MudItem>
                        <MudItem xs="12">
                            <ButtonSave ButtonType="ButtonType.Submit" />
                        </MudItem>
                    </GridDefault>
                </EditForm>
            }
        </MudStack>
    </DialogContent>
</MudDialog>
