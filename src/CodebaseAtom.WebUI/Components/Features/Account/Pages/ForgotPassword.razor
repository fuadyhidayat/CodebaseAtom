@page "/Account/ForgotPassword"

@layout LayoutLogin
@attribute [AllowAnonymous]

<HtmlHead Title="Forgot your password?" />
<MudContainer MaxWidth="MaxWidth.Small">
    <PageHeader Title="Forgot your password?" />
    <PageSection>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Success" Class="my-3">
                @_message
            </MudAlert>
        }
        @if (_resetPasswordLink is not null)
        {
            <div class="pa-4 rounded border-solid border mud-border-info">
                Normally, this would be emailed:
                <MudLink Href="@_resetPasswordLink">
                    <b>Click here to reset your password</b>
                </MudLink>
            </div>
        }
        else
        {
            <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync">
                <DataAnnotationsValidator />
                <GridDefault>
                    <MudItem xs="12">
                        <TextFieldDefault Label="Email"
                                          Placeholder="name@example.com"
                                          @bind-Value="Input.Email"
                                          For="@(() => Input.Email)" />
                    </MudItem>
                    <MudItem xs="12">
                        <ButtonPrimary StartIcon="@Icons.Material.Filled.LockReset" ButtonType="ButtonType.Submit">
                            Reset password
                        </ButtonPrimary>
                    </MudItem>
                </GridDefault>
            </EditForm>
        }
        <MudDivider Class="my-2" />
        <MudStack AlignItems="AlignItems.Start">
            <MudLink Href="@AccountRouteFor.Login()">Login</MudLink>
        </MudStack>
    </PageSection>
</MudContainer>
