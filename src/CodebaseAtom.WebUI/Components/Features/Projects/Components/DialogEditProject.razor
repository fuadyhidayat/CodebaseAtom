@inherits DialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Class="mb-3">
            <ErrorViewer Exception="ExceptionBase" />
            @if (Model is not null)
            {
                <EditForm Model="Model" OnValidSubmit="OnValidSubmitAsync">
                    <DataAnnotationsValidator />
                    <GridDefault>
                        <MudItem xs="12">
                            <TextFieldDefault Label="Title"
                                              Placeholder="Enter the project title"
                                              @bind-Value="Model.Title"
                                              For="@(() => Model.Title)" />
                        </MudItem>
                        <MudItem xs="12">
                            <TextFieldMultiline Label="Description"
                                                Placeholder="Enter the project description"
                                                Lines="3"
                                                MaxLines="5"
                                                @bind-Value="Model.Description"
                                                For="@(() => Model.Description)" />
                        </MudItem>
                    </GridDefault>
                    <BottomButtonPanel>
                        <ButtonSave ButtonType="ButtonType.Submit" />
                    </BottomButtonPanel>
                </EditForm>
            }
        </MudStack>
    </DialogContent>
</MudDialog>
