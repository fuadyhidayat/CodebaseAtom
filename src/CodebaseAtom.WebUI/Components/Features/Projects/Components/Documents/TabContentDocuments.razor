@inherits AppComponentBase

<MudStack Spacing="5">
    <TopButtonPanel>
        <ButtonAdd EntityType="@DomainDisplayTextFor.Document" OnClick="ShowDialogAddDocument" />
    </TopButtonPanel>
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="align-self-end">
        <TextFieldSearch @bind-Value="_searchKeyword" />
    </MudStack>

    @if (_items.Any())
    {
        <TableDefault Items="_items" Loading="IsLoadingBase" Filter="FilterItems">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DocumentModel, object>(x => x.Title)" InitialDirection="SortDirection.Ascending">
                        @DomainDisplayTextFor.Title
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DocumentModel, object>(x => x.FileName)">
                        @DomainDisplayTextFor.FileName
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Class="text-center">
                    <MudTableSortLabel SortBy="new Func<DocumentModel, object>(x => x.FileSize)">
                        @DomainDisplayTextFor.FileSize
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Class="text-center">
                    <MudTableSortLabel SortBy="new Func<DocumentModel, object>(x => x.CreatedAt)">
                        @DomainDisplayTextFor.CreatedAt
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Class="text-center">
                    @UIDisplayTextFor.Action
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@DomainDisplayTextFor.Title">
                    <MudHighlighter Text="@context.Title" HighlightedText="@_searchKeyword" />
                </MudTd>
                <MudTd DataLabel="@DomainDisplayTextFor.FileName">
                    <MudHighlighter Text="@context.FileName" HighlightedText="@_searchKeyword" />
                </MudTd>
                <MudTd DataLabel="@DomainDisplayTextFor.FileSize" Class="text-center">
                    @context.FileSize.ToReadableFileSize()
                </MudTd>
                <MudTd DataLabel="@DomainDisplayTextFor.CreatedAt" Class="text-center">
                    @context.CreatedAt.ToDisplayText(DateTimeFormatFor.LongDateTime)
                </MudTd>
                <MudTd DataLabel="@UIDisplayTextFor.Action" Class="text-center">
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Download" OnClick="@(() => HandleDownloadDocument(context))" />
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" OnClick="@(() => ShowDialogEditDocument(context))" />
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(() => ShowDialogDeleteDocument(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudPaper Elevation="0" Class="pa-5">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        There are no @DomainDisplayTextFor.Documents matching the selected filters. Please adjust your search criteria and try again.
                    </MudAlert>
                </MudPaper>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </TableDefault>
    }
    else
    {
        <MudAlert>
            This @DomainDisplayTextFor.Project has no @DomainDisplayTextFor.Documents yet.
        </MudAlert>
    }

</MudStack>
