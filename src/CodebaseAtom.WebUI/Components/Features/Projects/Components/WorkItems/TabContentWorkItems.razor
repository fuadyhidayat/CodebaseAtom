@inherits AppComponentBase

<MudStack>
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Start">
        <MudButtonGroup Color="Color.Primary"
                        Variant="Variant.Outlined"
                        Size="Size.Small">
            <MudStack Class="px-5 border rounded-tl rounded-bl mud-border-primary" Justify="Justify.Center">
                <MudText Class="text-bold">
                    @if (_isKanbanView)
                    {
                        <span>Kanban View</span>
                    }
                    else
                    {
                        <span>Table View</span>
                    }
                </MudText>
            </MudStack>
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                <MudMenuItem OnClick="() => _isKanbanView = true" Disabled="@_isKanbanView">Switch to Kanban View</MudMenuItem>
                <MudMenuItem OnClick="() => _isKanbanView = false" Disabled="@(!_isKanbanView)">Switch to Table View</MudMenuItem>
            </MudMenu>
        </MudButtonGroup>
        <MudStack Row="true" Spacing="1">
            @if (_selectedItems.Any())
            {
                <ButtonDelete EntityType="@DomainDisplayTextFor.WorkItems" OnClick="ShowDialogDeleteSelectedWorkItems" />
            }
            <ButtonAdd EntityType="@DomainDisplayTextFor.WorkItem" OnClick="ShowDialogAddWorkItem" />
        </MudStack>
    </MudStack>

    @if (_isKanbanView)
    {
        <MudDropContainer T="WorkItemModel"
                          @ref="_kanban"
                          Items="@_items"
                          Class="d-flex flex-row"
                          ItemsSelector="@((item, column) => item.Status.ToString() == column)"
                          ItemDropped="HandleItemDropped">
            <ChildContent>
                <GridDefault>
                    @foreach (var column in Columns)
                    {
                        <MudItem xs="12" sm="4">
                            <MudPaper Outlined="true"
                                      MinHeight="400px"
                                      Class="d-flex flex-column px-3 mud-background-gray">
                                <MudToolBar Gutters="false" Class="mb-6">
                                    <MudText Typo="Typo.h5" Class="my-auto">
                                        @column.Name
                                    </MudText>
                                    <MudSpacer />
                                    <MudBadge Color="Color.Primary"
                                              Overlap="true"
                                              Class="mr-2"
                                              Content="@_items.Count(x => x.Status == column)" />
                                </MudToolBar>
                                <MudDropZone T="WorkItemModel"
                                             Class="flex-grow-1"
                                             Identifier="@column.ToString()" />
                            </MudPaper>
                        </MudItem>
                    }
                </GridDefault>
            </ChildContent>
            <ItemRenderer>
                <MudPaper Outlined="true"
                          Class="mb-3 pa-3 mud-ripple"
                          Style="cursor: grab;">
                    <MudText Typo="Typo.h5" Class="mb-4">
                        @context.Title
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @context.Description
                    </MudText>
                    <MudDivider Class="my-2" />
                    <MudStack Row="true"
                              Justify="Justify.SpaceBetween"
                              AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @DomainDisplayTextFor.Deadline: @context.Deadline.ToDisplayText(DateFormatFor.LongDate)
                        </MudText>
                        <MudStack Row="true" Justify="Justify.FlexEnd">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           OnClick="@(() => ShowDialogEditWorkItem(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           OnClick="@(() => ShowDialogDeleteWorkItem(context))" />
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </ItemRenderer>
        </MudDropContainer>
    }
    else
    {
        <TableDefault Items="_items"
                      @bind-SelectedItems="_selectedItems"
                      T="WorkItemModel"
                      MultiSelection="true">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<WorkItemModel, object>(x => x.Title)">
                        @DomainDisplayTextFor.Title
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<WorkItemModel, object>(x => x.Description)">
                        @DomainDisplayTextFor.Description
                    </MudTableSortLabel>
                </MudTh>
                <MudTh class="text-center">
                    <MudTableSortLabel SortBy="new Func<WorkItemModel, object>(x => x.Deadline)" InitialDirection="SortDirection.Ascending">
                        @DomainDisplayTextFor.Deadline
                    </MudTableSortLabel>
                </MudTh>
                <MudTh class="text-center">
                    <MudTableSortLabel SortBy="new Func<WorkItemModel, object>(x => x.Status)">
                        @DomainDisplayTextFor.Status
                    </MudTableSortLabel>
                </MudTh>
                <MudTh class="text-center">
                    @UIDisplayTextFor.Action
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@DomainDisplayTextFor.Title">
                    @context.Title
                </MudTd>
                <MudTd DataLabel="@DomainDisplayTextFor.Description">
                    @context.Description
                </MudTd>
                <MudTd DataLabel="@DomainDisplayTextFor.Deadline" class="text-center">
                    @context.Deadline.ToDisplayText(DateFormatFor.LongDate)
                </MudTd>
                <MudTd DataLabel="@DomainDisplayTextFor.Status" class="text-center">
                    @context.Status.Name
                </MudTd>
                <MudTd DataLabel="@UIDisplayTextFor.Action" class="text-center">
                    <ButtonEdit OnClick="@(() => ShowDialogEditWorkItem(context))" />
                    <ButtonDelete OnClick="@(() => ShowDialogDeleteWorkItem(context))" />
                </MudTd>
            </RowTemplate>
        </TableDefault>
    }
</MudStack>
